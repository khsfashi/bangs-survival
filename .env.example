# Kakao Maps Web JavaScript key. This key is intentionally client-visible.
# Restrict JavaScript SDK domains in Kakao Developers.
KAKAO_JAVASCRIPT_KEY=

# Existing public-housing-guide deployments may already use either alias below.
# The app accepts them for compatibility; do not duplicate the value if one is already set.
# NEXT_PUBLIC_KA_KAO_MAP_CLIENT_KEY=
# NEXT_PUBLIC_KAKAO_MAP_CLIENT_KEY=

# KMA APIHub auth key. Server-side only; never expose this value to the browser.
KMA_API_KEY=
